# CartPilot AI Environment Configuration

# Application
APP_NAME="CartPilot AI"
APP_VERSION="1.0.0"
PORT=8000
HOST="0.0.0.0"

# Database (Default is local SQLite, supports PostgreSQL: postgresql://user:pass@localhost:5432/cartpilot)
DATABASE_URL="sqlite:///./cartpilot.db"

# Mode Flags
DEMO_MODE=true

# Optional LLM integration (fallback to deterministic mathematical scoring if omitted)
GEMINI_API_KEY=""

# Frontend API URL
VITE_API_URL="http://localhost:8000"
